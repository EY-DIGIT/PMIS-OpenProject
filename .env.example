# Copy this file to .env and adjust for your environment.
# DO NOT commit .env (it's gitignored).

# --- Database ---
DATABASE_URL=postgresql://pmis:CHANGE_ME@localhost:5432/pmis

# Only needed if you use infra/docker-compose.yml (Docker route).
# Must match the user/password/db inside DATABASE_URL above.
POSTGRES_USER=pmis
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pmis

# --- Security ---
# 32+ character random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-in-prod-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
APP_NAME=PMIS API
APP_VERSION=3.0.0
DEBUG=false

# --- Bootstrap admin (only inserted if no admin exists) ---
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- File attachments (Comments & Attachments) ---
# All values are env-driven and can change per environment without
# code redeploys.

# Where attachment bytes are stored. In prod this is the NFS mount
# point. In dev, a local folder. Created at startup if missing.
ATTACHMENTS_STORAGE_BASE_PATH=./local_uploads

# Per-file size cap (bytes). 25 MB matches the frontend design.
ATTACHMENTS_MAX_BYTES=26214400

# Allowed file extensions (no leading dots, case-insensitive).
ATTACHMENTS_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt,csv,png,jpg,jpeg,gif,webp

# Subdirectory strategy under base path: "year_month" or "flat".
ATTACHMENTS_SUBDIR_STRATEGY=year_month

# Days to keep file bytes after soft-delete before purge.
ATTACHMENTS_RETENTION_DAYS=90

# Behaviour when storage is unreachable: "fail".
ATTACHMENTS_ON_UNAVAILABLE=fail

# Informational only — surfaced in /health and boot logs. Leave empty
# in dev. In prod, set to the NFS server's address and export path.
# The app NEVER connects to these directly; the OS mount does.
ATTACHMENTS_NFS_SERVER=
ATTACHMENTS_NFS_EXPORT=
